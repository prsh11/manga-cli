#!/usr/bin/env bash

#DEPENDENCIES="pup zathura zathura-cb curl"

echo "Detecting Linux distribution..."
if [ -f /etc/os-release ]; then
  . /etc/os-release
  DISTRO=$ID
else
  echo "Cannot detect Linux distribution."
  exit 1
fi

echo "Detected distro: $DISTRO"

install_pup() {
  echo "Installing pup github release..."

  curl -Lo pup.zip "https://release-assets.githubusercontent.com/github-production-release-asset/23527160/aeab6e98-5057-11e6-803b-64a206c2d735?sp=r&sv=2018-11-09&sr=b&spr=https&se=2025-11-03T19%3A20%3A58Z&rscd=attachment%3B+filename%3Dpup_v0.4.0_linux_amd64.zip&rsct=application%2Foctet-stream&skoid=96c2d410-5711-43a1-aedd-ab1947aa7ab0&sktid=398a6654-997b-47e9-b12b-9515b896b4de&skt=2025-11-03T18%3A20%3A07Z&ske=2025-11-03T19%3A20%3A58Z&sks=b&skv=2018-11-09&sig=DSQ9V4I8QFbAB9qQaTGD8prXItwVMu%2BRt2slkLBp96Y%3D&jwt=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJnaXRodWIuY29tIiwiYXVkIjoicmVsZWFzZS1hc3NldHMuZ2l0aHVidXNlcmNvbnRlbnQuY29tIiwia2V5Ijoia2V5MSIsImV4cCI6MTc2MjE5NDk4NCwibmJmIjoxNzYyMTk0Njg0LCJwYXRoIjoicmVsZWFzZWFzc2V0cHJvZHVjdGlvbi5ibG9iLmNvcmUud2luZG93cy5uZXQifQ.9pGgzqHQtDsEpfJnT8oS7JRzKA0z3CF0xBEtQglcy9g&response-content-disposition=attachment%3B%20filename%3Dpup_v0.4.0_linux_amd64.zip&response-content-type=application%2Foctet-stream"
  unzip pup.zip

  sudo mv pup /usr/local/bin/
  sudo chmod +x /usr/local/bin/pup

  rm pup.zip
}

install_packages_apt() {
  echo "Installing dependencies for Debian/Ubuntu..."

  sudo apt install -y zathura zathura-cb curl unzip
  install_pup
}

install_packages_dnf() {
  echo "Installing dependencies for Fedora..."
  sudo dnf install -y zathura zathura-cb curl unzip
  install_pup
}

install_packages_pacman() {
  echo "Installing dependencies for Arch..."
  sudo pacman -S --noconfirm pup zathura zathura-cb curl
}

case "$DISTRO" in
ubuntu | debian)
  install_packages_apt
  ;;
fedora)
  install_packages_dnf
  ;;
arch)
  install_packages_pacman
  ;;
*)
  echo "Unsupported Linux distribution: $DISTRO"
  exit 1
  ;;
esac

echo "All dependencies installed successfully."
